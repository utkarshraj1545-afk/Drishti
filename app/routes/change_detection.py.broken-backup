        "increased": "वनस्पति में वृद्धि",
        "gain": "वनस्पति में वृद्धि",
        "vegetation loss": "वनस्पति में कमी",
        "decrease": "वनस्पति में कमी",
        "decreased": "वनस्पति में कमी",
        "loss": "वनस्पति में कमी",
        "stable": "वनस्पति में कोई स्पष्ट बदलाव नहीं",
        "no clear vegetation change": "वनस्पति में कोई स्पष्ट बदलाव नहीं",
        "no significant change": "वनस्पति में कोई स्पष्ट बदलाव नहीं",
