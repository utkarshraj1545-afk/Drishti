def _display_value(value: Any, missing: str) -> str:
    if value is None:
        return missing
    if isinstance(value, float):
        return f"{value:.4f}"
    return str(value)


def _create_pdf_report(request: ChangeDetectionRequest, analysis: dict) -> bytes:
    """Create a bilingual ReportLab PDF from the analysis response."""
    try:
        from reportlab.lib import colors
        from reportlab.lib.enums import TA_LEFT
        from reportlab.lib.pagesizes import A4
        from reportlab.lib.styles import getSampleStyleSheet, ParagraphStyle
        from reportlab.lib.units import mm
        from reportlab.pdfbase import pdfmetrics
        from reportlab.pdfbase.ttfonts import TTFont
        from reportlab.platypus import (
            SimpleDocTemplate,
            Paragraph,
            Spacer,
            Table,
            TableStyle,
        )
    except ImportError as exc:
        raise HTTPException(
            status_code=500,
            detail="PDF generation dependency is not installed.",
        ) from exc

    language = _language(request)
    labels = _report_labels(language)
    missing = labels["not_available"]

    output = BytesIO()
    document = SimpleDocTemplate(
        output,
        pagesize=A4,
        rightMargin=18 * mm,
        leftMargin=18 * mm,
        topMargin=18 * mm,
        bottomMargin=18 * mm,
        title=labels["title"],
        author="DRISHTI",
    )

    styles = getSampleStyleSheet()
    normal = styles["BodyText"]
    normal.fontSize = 9
    normal.leading = 13

    title_style = ParagraphStyle(
        "DrishtiTitle",
        parent=styles["Title"],
        fontSize=17,
        leading=22,
        alignment=TA_LEFT,
        spaceAfter=12,
    )

    # Register the bundled Devanagari font when producing a Hindi report.
    if language == "hi":
        font_path = (
            Path(__file__).resolve().parents[1]
            / "assets"
            / "NotoSansDevanagari-Regular.ttf"
        )
        if font_path.exists():
            try:
                if "DrishtiHindi" not in pdfmetrics.getRegisteredFontNames():
                    pdfmetrics.registerFont(
                        TTFont("DrishtiHindi", str(font_path))
                    )
                normal.fontName = "DrishtiHindi"
                title_style.fontName = "DrishtiHindi"
            except Exception:
                # Keep PDF generation available if font registration fails.
                pass

    story = [
        Paragraph(labels["title"], title_style),
        Paragraph(
            f"{labels['area']}: "
            f"W {request.west:.5f}, S {request.south:.5f}, "
            f"E {request.east:.5f}, N {request.north:.5f}",
            normal,
        ),
        Spacer(1, 8),
    ]

    table_data = [
        [
            "Metric",
            labels["before"],
            labels["after"],
        ],
        [
            labels["mean_ndvi"],
            _display_value(analysis["before"].get("mean_ndvi"), missing),
            _display_value(analysis["after"].get("mean_ndvi"), missing),
        ],
        [
            labels["scenes"],
            _display_value(analysis["before"].get("scenes"), missing),
            _display_value(analysis["after"].get("scenes"), missing),
        ],
        [
            labels["coverage"],
            _display_value(analysis["before"].get("coverage_percent"), missing),
            _display_value(analysis["after"].get("coverage_percent"), missing),
        ],
    ]

    if (
        "water_area_km2" in analysis["before"]
        or "water_area_km2" in analysis["after"]
    ):
        table_data.extend(
            [
                [
                    labels["water"],
                    _display_value(
                        analysis["before"].get("water_area_km2"), missing
                    ),
                    _display_value(
                        analysis["after"].get("water_area_km2"), missing
                    ),
                ],
                [
                    labels["water_valid"],
                    _display_value(
                        analysis["before"].get("water_valid_area_km2"), missing
                    ),
                    _display_value(
                        analysis["after"].get("water_valid_area_km2"), missing
                    ),
                ],
                [
                    labels["water_percent"],
                    _display_value(
                        analysis["before"].get("water_percent_valid"), missing
                    ),
                    _display_value(
                        analysis["after"].get("water_percent_valid"), missing
                    ),
                ],
            ]
        )

    table = Table(table_data, colWidths=[68 * mm, 48 * mm, 48 * mm], repeatRows=1)
    table.setStyle(
        TableStyle(
            [
                ("BACKGROUND", (0, 0), (-1, 0), colors.HexColor("#173D35")),
                ("TEXTCOLOR", (0, 0), (-1, 0), colors.white),
                ("GRID", (0, 0), (-1, -1), 0.4, colors.HexColor("#CBD5D1")),
                ("VALIGN", (0, 0), (-1, -1), "TOP"),
                ("LEFTPADDING", (0, 0), (-1, -1), 6),
                ("RIGHTPADDING", (0, 0), (-1, -1), 6),
                ("TOPPADDING", (0, 0), (-1, -1), 6),
                ("BOTTOMPADDING", (0, 0), (-1, -1), 6),
                ("FONTNAME", (0, 0), (-1, -1), normal.fontName),
            ]
        )
    )

    story.extend(
        [
            table,
            Spacer(1, 12),
            Paragraph(
                f"<b>{labels['change']}:</b> "
                f"{_display_value(analysis.get('change_percent'), missing)}",
                normal,
            ),
            Paragraph(
                f"<b>{labels['classification']}:</b> "
                f"{analysis.get('classification', missing)}",
                normal,
            ),
            Spacer(1, 8),
            Paragraph(f"<b>{labels['note']}:</b>", normal),
            Paragraph(analysis.get("note", ""), normal),
        ]
    )

    warnings = analysis.get("coverage_warnings") or []
    if warnings:
        story.extend(
            [
                Spacer(1, 8),
                Paragraph(f"<b>{labels['warnings']}:</b>", normal),
            ]
        )
        for warning in warnings:
            story.append(Paragraph(f"• {warning}", normal))

    if analysis.get("water_note"):
        story.extend(
            [
                Spacer(1, 8),
                Paragraph(f"<b>{labels['water_note']}:</b>", normal),
                Paragraph(analysis["water_note"], normal),
            ]
        )

    story.extend(
        [
            Spacer(1, 12),
            Paragraph(
                "DRISHTI — satellite-based environmental screening. "
                "Results depend on image availability and analysis assumptions; "
                "field verification is recommended.",
                normal,
            ),
        ]
    )

    document.build(story)
    return output.getvalue()


@router.post("/analyze/change/pdf")
def analyze_change_pdf(request: ChangeDetectionRequest):
    """Return the analysis as a downloadable PDF report."""
    analysis = run_analysis(request)
    pdf_bytes = _create_pdf_report(request, analysis)

    filename = "drishti_environmental_change_report.pdf"
    return StreamingResponse(
        BytesIO(pdf_bytes),
        media_type="application/pdf",
        headers={
            "Content-Disposition": f'attachment; filename="{filename}"'
        },
    )
