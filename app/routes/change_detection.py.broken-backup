)

router = APIRouter()


class ChangeDetectionRequest(BaseModel):
    west: float
    south: float
    east: float
    north: float

    before_start: date
    before_end: date
    after_start: date
    after_end: date

    language: str = "en"
    max_cloud_pct: float = Field(default=80, gt=0, le=100)


def _validate_request(request: ChangeDetectionRequest) -> None:
    """Validate coordinates and date ranges before starting satellite analysis."""
    if not (
        -180 <= request.west < request.east <= 180
        and -90 <= request.south < request.north <= 90
    ):
        raise HTTPException(
            status_code=422,
            detail="Invalid area coordinates. Check west, south, east and north.",
        )

    if request.before_start > request.before_end:
        raise HTTPException(
            status_code=422,
            detail="The before-period start date must be on or before its end date.",
        )

    if request.after_start > request.after_end:
        raise HTTPException(
            status_code=422,
            detail="The after-period start date must be on or before its end date.",
        )

    if request.before_end >= request.after_start:
        raise HTTPException(
            status_code=422,
            detail="The before and after periods must not overlap.",
        )


def _safe_float(value: Any) -> Optional[float]:
    """Return a finite float, or None for missing/invalid values."""
    if value is None or isinstance(value, bool):
        return None

    try:
        result = float(value)
    except (TypeError, ValueError, OverflowError):
        return None

    if result != result or result in (float("inf"), float("-inf")):
        return None

    return result

def is_hindi(language: str) -> bool:
    """Return True when the requested language is Hindi."""
    return str(language).lower().startswith("hi")


def _language(request: ChangeDetectionRequest) -> str:
    """Use Hindi when explicitly requested; otherwise default to English."""
    return "hi" if str(request.language).lower().startswith("hi") else "en"


def _period_payload(
    period: dict,
    water: Optional[dict] = None,
) -> dict:
    """Build a JSON-safe period result without exposing Earth Engine objects."""
    scene_count = period.get("scene_count", period.get("scenes", 0))
    valid_pixel_count = period.get("valid_pixel_count", 0)
    total_pixel_count = period.get("total_pixel_count", 0)

    result = {
        "mean_ndvi": _safe_float(period.get("mean_ndvi")),
        "scene_count": scene_count,
        "scenes": scene_count,
        "valid_pixel_count": valid_pixel_count,
        "total_pixel_count": total_pixel_count,
        "coverage_percent": _safe_float(period.get("coverage_percent")),
        "coverage_warning": bool(period.get("coverage_warning", False)),
    }

    if water is not None:
        result["water_area_km2"] = _safe_float(
            water.get("water_area_km2")
        )
        result["water_valid_area_km2"] = _safe_float(
            water.get(
                "water_valid_area_km2",
                water.get("valid_area_km2"),
            )
        )
        result["water_percent_valid"] = _safe_float(
            water.get("water_percent_valid")
        )

    return result

