            "प्रभाव डाल सकते हैं; बदलाव अपने-आप में सूखा, बाढ़ या अतिक्रमण "
            "सिद्ध नहीं करता। स्थल पर जाँच करें।"
        )

    return (
        "Water extent is estimated using MNDWI > 0 as an initial screening "
        "heuristic, not an authoritative water classification. Seasonality, "
        "clouds and image availability can affect the estimate. A change alone "
        "does not prove drought, flooding or encroachment; verify on the ground."
    )


def _get_water_metrics(period: dict, aoi: Any) -> Optional[dict]:
    """Calculate water metrics only when a usable composite image is present."""
    composite = period.get("composite_image")
    if composite is None:
        return None

    try:
        water = get_mndwi_water_extent(composite, aoi)
        return water if isinstance(water, dict) else None
    except Exception:
        # Water estimation is supplementary. Do not discard a valid NDVI result.
        return None


def run_analysis(request: ChangeDetectionRequest) -> dict:
    """Run two-period NDVI change analysis and optional MNDWI water estimates."""
    _validate_request(request)
    language = _language(request)

    try:
        init_earth_engine()
        aoi = resolve_aoi(
            request.west,
            request.south,
            request.east,
            request.north,
        )

        before_result = get_ndvi_for_period(
            aoi=aoi,
            start_date=request.before_start.isoformat(),
            end_date=request.before_end.isoformat(),
            max_cloud_pct=request.max_cloud_pct,
        )

        after_result = get_ndvi_for_period(
            aoi=aoi,
            start_date=request.after_start.isoformat(),
            end_date=request.after_end.isoformat(),
            max_cloud_pct=request.max_cloud_pct,
        )

        if not isinstance(before_result, dict) or not isinstance(after_result, dict):
            raise HTTPException(
                status_code=502,
                detail="Satellite analysis returned an unexpected result.",
            )

        before_ndvi = _safe_float(before_result.get("mean_ndvi"))
        after_ndvi = _safe_float(after_result.get("mean_ndvi"))

        if before_ndvi is None or after_ndvi is None:
            raise HTTPException(
                status_code=422,
                detail=(
                    "NDVI could not be calculated for one or both periods. "
                    "Try different dates or a less cloudy period."
                ),
            )

        # Keep the change calculation in run_analysis scope.
        change_result = compute_change(before_ndvi, after_ndvi)

        before_water = _get_water_metrics(before_result, aoi)
        after_water = _get_water_metrics(after_result, aoi)

        before = _period_payload(before_result, before_water)
        after = _period_payload(after_result, after_water)

        before_coverage = _safe_float(before.get("coverage_percent"))
        after_coverage = _safe_float(after.get("coverage_percent"))
        threshold = _safe_float(COVERAGE_WARNING_THRESHOLD)

        low_coverage = (
            threshold is not None
            and (
                (before_coverage is not None and before_coverage < threshold)
                or (after_coverage is not None and after_coverage < threshold)
            )
        )

        coverage_warnings = []

        if before.get("coverage_warning") or (
            before_coverage is not None
            and threshold is not None
            and before_coverage < threshold
        ):
            coverage_warnings.append(
                "पहली अवधि में वैध उपग्रह डेटा का कवरेज कम है।"
                if language == "hi"
                else "Valid satellite-data coverage is low for the before period."
            )

        if after.get("coverage_warning") or (
            after_coverage is not None
            and threshold is not None
            and after_coverage < threshold
        ):
            coverage_warnings.append(
                "दूसरी अवधि में वैध उपग्रह डेटा का कवरेज कम है।"
                if language == "hi"
                else "Valid satellite-data coverage is low for the after period."
            )

        result = {
            "before": before,
            "after": after,
            "change_percent": _safe_float(
                change_result.get(
                    "pct_change",
                    change_result.get("change_percent"),
                )
            ),
            "classification": _classification(change_result, language),
            "note": _analysis_note(language, low_coverage),
            "max_cloud_pct": request.max_cloud_pct,
            "coverage_warning_threshold": COVERAGE_WARNING_THRESHOLD,
            "coverage_warnings": coverage_warnings,
        }

        if before_water is not None or after_water is not None:
            result["water_note"] = _water_note(language)

        return result

    except HTTPException:
        raise
    except Exception as exc:
        # Keep implementation details and credentials out of public responses.
        raise HTTPException(
            status_code=500,
            detail=f"Analysis failed: {type(exc).__name__}. Check the backend logs.",
        ) from exc


@router.post("/analyze/change")
def analyze_change(request: ChangeDetectionRequest) -> dict:
    """Return the two-period satellite change analysis."""
    return run_analysis(request)

