def _classification(change_result: dict, language: str) -> str:
    """Translate the vegetation-change classification for the API response."""
    direction = str(change_result.get("direction", "stable")).lower()

    if direction in {"increase", "increased", "gain", "vegetation gain"}:
        return "वनस्पति में वृद्धि" if language == "hi" else "Vegetation gain"

    if direction in {"decrease", "decreased", "loss", "vegetation loss"}:
        return "वनस्पति में कमी" if language == "hi" else "Vegetation loss"

    return "वनस्पति में कोई स्पष्ट बदलाव नहीं" if language == "hi" else "No clear vegetation change"


