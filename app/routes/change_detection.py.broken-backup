    """Return the scientific caveat appropriate for the selected language."""
    if language == "hi":
        note = (
            "NDVI वनस्पति की हरियाली का संकेत देता है; यह सीधे पेड़ों की "
            "संख्या या जंगल के स्वास्थ्य को प्रमाणित नहीं करता। NDVI में "
            "कमी अपने-आप में वनों की कटाई का प्रमाण नहीं है। बादल, छाया, "
            "मौसम और उपलब्ध उपग्रह चित्र परिणामों को प्रभावित कर सकते हैं। "
            "महत्वपूर्ण निष्कर्षों की स्थल पर जाँच करें।"
        )
        if low_coverage:
            note += (
                " उपलब्ध वैध उपग्रह डेटा का कवरेज कम है, इसलिए परिणाम "
                "को सावधानी से समझें।"
            )
        return note

    note = (
        "NDVI indicates vegetation greenness; it does not directly measure "
        "tree count or prove forest health. An NDVI decrease alone does not "
        "prove deforestation. Clouds, shadows, seasonality and satellite-image "
        "availability can affect the result. Verify important findings on the ground."
    )
    if low_coverage:
        note += (
            " Valid satellite-data coverage is low for at least one period, "
            "so interpret the result cautiously."
        )
    return note


